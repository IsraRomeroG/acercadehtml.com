---
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	currentPath: string;
}

const { title, description, currentPath } = Astro.props;
const pageTitle = title === "Inicio" ? "Acerca de HTML — Aprende HTML paso a paso" : `${title} | Acerca de HTML`;
const isManual = currentPath === "/manual-html.html" || currentPath.startsWith("/manual-html/");
const isTags = currentPath === "/etiquetas-html.html" || currentPath.startsWith("/etiquetas-html/");
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#fffaf5" />
		<link rel="icon" href="/images/favicon.ico" sizes="any" />
		<title>{pageTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Saltar al contenido</a>
		<header class="site-header">
			<div class="header-inner">
				<a class="brand" href="/" aria-label="Acerca de HTML, inicio">
					<img src="/images/logo.png" alt="Acerca de HTML" width="180" height="60" />
				</a>
				<nav class="main-nav" aria-label="Navegación principal">
					<a href="/" aria-current={currentPath === "/" ? "page" : undefined} class:active={currentPath === "/"}>Inicio</a>
					<a href="/manual-html.html" aria-current={isManual ? "page" : undefined} class:active={isManual}>Manual HTML</a>
					<a href="/etiquetas-html.html" aria-current={isTags ? "page" : undefined} class:active={isTags}>Etiquetas HTML</a>
				</nav>
			</div>
		</header>

		<div class="site-grid">
			<main id="main"><slot /></main>
			<aside id="aside" class="sidebar" aria-label="Recursos y publicidad">
				<section class="sidebar-card learning-card">
					<p class="eyebrow">Para empezar</p>
					<h2>Aprende paso a paso</h2>
					<p>Un recorrido sencillo para entender HTML desde sus fundamentos.</p>
					<a class="text-link" href="/manual-html/introduccion.html">Comenzar el manual <span aria-hidden="true">→</span></a>
				</section>
				<section class="sidebar-card quick-links" aria-labelledby="quick-links-title">
					<h2 id="quick-links-title">Explora el sitio</h2>
					<a href="/manual-html.html">Guía de HTML</a>
					<a href="/etiquetas-html.html">Índice de etiquetas</a>
					<a href="/manual-html/como-crear-una-pagina-html.html">Crear tu primera página</a>
				</section>
				<section class="ad-slot" aria-label="Publicidad">
					<p class="ad-label">Publicidad</p>
				</section>
			</aside>
		</div>

		<footer class="site-footer">
			<div class="footer-inner">
				<a href="/" class="footer-brand">Acerca de HTML</a>
				<p>© Copyright — Acerca de HTML. Todos los derechos reservados.<br />Queda prohibida la distribución total o parcial del contenido sin el consentimiento previo del autor.</p>
			</div>
		</footer>
		<script defer src="/js/ads.js"></script>
	</body>
</html>
